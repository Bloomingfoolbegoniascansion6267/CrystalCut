{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "CrystalCut main window with only the dialog and core event permissions it needs.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-confirm",
    "dialog:allow-open",
    "os:allow-locale"
  ]
}
