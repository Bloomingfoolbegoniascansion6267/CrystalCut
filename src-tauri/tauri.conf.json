{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CrystalCut",
  "version": "1.0.5",
  "identifier": "com.crystalcut.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CrystalCut",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost",
      "capabilities": ["main-capability"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "copyright": "Copyright 2026 pkh31337",
    "homepage": "https://pkh31337.com",
    "license": "Apache-2.0",
    "licenseFile": "../LICENSE",
    "resources": {
      "../NOTICE": "NOTICE",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "GraphicsAndDesign",
    "shortDescription": "Local-first AI background removal and batch image conversion.",
    "longDescription": "CrystalCut removes image backgrounds locally, refines object masks with brushes and exports optimized PNG or WebP files in batches.",
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
